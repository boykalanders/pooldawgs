# WalletConnect cloud project id (https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Authoritative game server
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# Deployed contracts (leave empty for the look-and-feel review build).
# Ecosystem addresses on Ethereum mainnet:
#   $DDawgs token: 0x19f78a898f3e3c2f40c6E0CD2EE5545F549d5E99
#   Gate NFT (CDNFT): 0xf82E0cF5605101efE12689461c2bC9392BfDedEF
NEXT_PUBLIC_POOLDAWGS_ADDRESS=
NEXT_PUBLIC_DDAWGS_TOKEN_ADDRESS=
NEXT_PUBLIC_DDAWGS_NFT_ADDRESS=

# Chain id the contracts live on (1 = Ethereum mainnet, 11155111 = Sepolia)
NEXT_PUBLIC_CHAIN_ID=1
