PORT=4000

# Comma-separated origins allowed to connect (the Next.js app)
CORS_ORIGINS=http://localhost:3000

# ── Chain wiring ────────────────────────────────────────────────
# Leave every RPC_URL* / CONTRACT_ADDRESS empty to run in chain-less dev
# mode (ad-hoc rooms, no settlement) for local play-testing.
#
# RPC endpoints, tried in this order with automatic failover: Alchemy, Infura,
# each of RPC_URL_FALLBACKS, then RPC_URL. A failing provider is paused (30s,
# growing to 30 min on repeat failures) instead of being retried on every call.
RPC_URL_ALCHEMY=
RPC_URL_INFURA=
RPC_URL_FALLBACKS=
RPC_URL=
# Chain id (11155111 Sepolia, 1 mainnet). Optional; saves a lookup per provider.
CHAIN_ID=
CONTRACT_ADDRESS=
# Block the contract was deployed at — read once on the very first start.
CONTRACT_DEPLOY_BLOCK=

# ── Contract events (live) ──────────────────────────────────────
# Events arrive over a WebSocket subscription — no log polling. The WSS URLs
# are derived from RPC_URL_ALCHEMY / RPC_URL_INFURA; set these only to override.
# RPC_WSS_URL_ALCHEMY=
# RPC_WSS_URL_INFURA=
# Any other WebSocket endpoint, e.g. wss://ethereum-sepolia-rpc.publicnode.com
# RPC_WSS_URL=
# RPC_WSS_URL_FALLBACKS=
# Catch-up reads (startup, reconnect, safety check) start at the saved block,
# at most this many blocks per request. Alchemy's FREE tier allows only 10.
CHAIN_EVENT_BACKFILL_MAX_BLOCKS=500
# Safety check: catch up from the saved block this often (default 30 min).
# CHAIN_EVENT_RECONCILE_INTERVAL_MS=1800000
# Only without any WebSocket endpoint: catch-up interval instead (default 30s,
# one request — set a WSS URL above so nothing is polled at all).
# CHAIN_EVENT_FALLBACK_POLL_MS=30000

# ── Keys ────────────────────────────────────────────────────────
# Signs win vouchers (must be the contract's resultSigner) and sends the
# backstop finishGame for wins left unclaimed. Prefer the low-privilege
# operator key (setOperator + setResultSigner on the contract); the owner key
# is a fallback. Production: inject from a secret manager. NEVER commit a key.
OPERATOR_PRIVATE_KEY=
OWNER_PRIVATE_KEY=
# A win unclaimed for this long is recorded on-chain with finishGame, after
# which the winner claims with claimReward (default 24h).
# SETTLE_UNCLAIMED_AFTER_MS=86400000
# Waiting room: after both players pay, the shot clock only starts once BOTH are
# at the table. If that doesn't happen within this time, both stakes are
# refunded in full (refundUnstarted, sent with the key above). Default 30 min.
# WAITING_ROOM_TIMEOUT_MS=1800000

# ── Storage ─────────────────────────────────────────────────────
# Game results, live tables, the lobby, the leaderboard and the event cursor
# are stored here and survive restarts. Postgres if set, else SQLite.
DATABASE_URL=
# SQLITE_PATH=./leaderboard.db

# ── Alerts ──────────────────────────────────────────────────────
# Daily stuck-funds report (only sent when something needs a human).
TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# STUCK_FUNDS_REPORT_INTERVAL_MS=86400000

# Override the 4-minute shot clock (ms) — tests/dev only.
SHOT_CLOCK_MS=
