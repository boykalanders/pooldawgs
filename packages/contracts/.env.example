# RPC for the target network. The Deputy Dawgs ecosystem lives on Ethereum
# mainnet; use Sepolia for rehearsal deploys.
TESTNET_RPC_URL=

# Deployer = contract owner = backend relayer key.
# In production this key lives in a KMS/secret manager, never in this file.
DEPLOYER_PRIVATE_KEY=

# Existing ecosystem contracts (Ethereum mainnet values):
#   $DDawgs ERC-20:  0x19f78a898f3e3c2f40c6E0CD2EE5545F549d5E99
#   Gate NFT (CDNFT): 0xf82E0cF5605101efE12689461c2bC9392BfDedEF
DDAWGS_TOKEN_ADDRESS=
DDAWGS_NFT_ADDRESS=

# Payout wiring: poolAddress receives the 10% burn cut (ChessDawgs naming),
# companyWallet receives the 10% company cut.
POOL_ADDRESS=
COMPANY_WALLET=
